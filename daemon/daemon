#!/bin/bash
# Midea2Lox - Startskript (wird von LoxBerry beim Systemstart aufgerufen)
#
# ===================================================================
# WARUM HIER KEIN "ps -C" UND KEIN "killall" MEHR STEHT
# ===================================================================
#
# Bis 4.0.0 stand hier:
#
#     is_running() { /bin/ps -C "midea2lox.py" -opid= > /dev/null 2>&1; }
#     ...
#     'stop')  killall midea2lox.py;;
#
# Beides sucht nach dem PROZESSNAMEN. Der ist bei einem Skript mit
# Shebang-Zeile aber der INTERPRETER - hier also python3, nicht
# midea2lox.py. Nachgemessen: "ps -C midea2lox.py" liefert keinen Treffer,
# und "killall midea2lox.py" meldet "no process found", waehrend der Prozess
# weiterlaeuft.
#
# Die Folgen waren:
#   - "status" meldete IMMER "Midea2Lox is stopped", auch im Betrieb,
#   - "start" startete deshalb jedes Mal eine WEITERE Ausfertigung,
#   - "stop" beendete gar nichts.
#
# Zwei parallel laufende Dienste melden sich beide beim selben MQTT-Broker
# an und schreiben abwechselnd in dieselben Themen.
#
# Deshalb: eine PID-Datei, die dieses Skript selbst anlegt, mit
# argumentweiser Gegenprobe ueber /proc/<pid>/cmdline. Argumentweise, nicht
# als Teilzeichenkette - eine fremde Kommandozeile kann den Namen zufaellig
# enthalten, und ein kill an den Falschen ist nicht rueckgaengig zu machen.

datadir=REPLACELBPDATADIR
logdir=REPLACELBPLOGDIR
piddatei="$datadir/dienst.pid"
# Merkdatei fuer den minuetlichen Waechter (cron/cron.01min): Sie sagt, ob
# der Dienst laufen SOLL. Ohne sie wuerde der Waechter einen bewusst
# angehaltenen Dienst nach spaetestens einer Minute wieder hochfahren.
sollmarke="$datadir/soll_laufen"
programm="$datadir/midea2lox.py"

mkdir -p "$logdir" "$datadir" 2>/dev/null

# Gehoert die Prozessnummer wirklich zu unserem Dienst?
gehoert_uns() {
    [ -n "$1" ] || return 1
    tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null \
        | sed 's#.*/##' | grep -qx "midea2lox.py"
}

laufende_pid() {
    [ -f "$piddatei" ] || return 1
    local p
    p=$(cat "$piddatei" 2>/dev/null)
    case "$p" in
        ''|*[!0-9]*) return 1 ;;
    esac
    if gehoert_uns "$p"; then
        echo "$p"
        return 0
    fi
    return 1
}

start_dienst() {
    local p
    if p=$(laufende_pid); then
        echo "Midea2Lox laeuft bereits. PID: $p"
        return 0
    fi
    if [ ! -x "$programm" ]; then
        echo "FEHLER: $programm fehlt oder ist nicht ausfuehrbar."
        return 1
    fi
    echo "Starte Midea2Lox..."
    touch "$sollmarke" 2>/dev/null
    cd "$datadir" || return 1
    if [ "$(id -u)" -eq 0 ]; then
        # Die geschweiften Klammern sind der ganze Unterschied.
        #
        # Ohne sie beendet das "&" die GANZE UND-Liste, nicht nur den
        # nohup-Aufruf: in den Hintergrund geht dann "cd ... && nohup ...",
        # und $! ist die Nummer der Huellschale, nicht die von python3.
        # Gemessen unter bash 5.3: in der PID-Datei stand 4077, das echte
        # python3 lief als 4080. gehoert_uns() sucht "midea2lox.py"
        # argumentweise in /proc/<pid>/cmdline und findet in der Huellschale
        # nur "bash", "-c" und den Befehlstext - also nie einen Treffer.
        #
        # Die Folge betraf nur den root-Zweig, dafuer vollstaendig: "status"
        # meldete dauerhaft "gestoppt", waehrend der Dienst arbeitete; der
        # minuetliche Waechter startete jede Minute neu und gab nach fuenf
        # Versuchen auf; und "stop", preupgrade.sh und uninstall konnten den
        # Prozess nie mehr erreichen - er ueberlebte Update und
        # Deinstallation.
        su loxberry -c "cd '$datadir' && { nohup ./midea2lox.py >/dev/null 2>&1 & echo \$! > '$piddatei'; }"
        chown loxberry:loxberry "$piddatei" 2>/dev/null
    else
        nohup ./midea2lox.py >/dev/null 2>&1 &
        echo $! > "$piddatei"
    fi
    # Die WIRKUNG pruefen, nicht den Aufruf.
    #
    # Bis 4.2.12 stand hier nur "sleep 1", und start_dienst meldete IMMER
    # Erfolg. Kam der Dienst wegen einer unbrauchbaren Konfiguration gar
    # nicht hoch, sagte "status" danach "gestoppt", der minuetliche Waechter
    # startete ihn neu, und das wiederholte sich endlos - ohne dass irgendwo
    # der Grund stand.
    sleep 2
    if laufende_pid >/dev/null; then
        echo "Midea2Lox laeuft. PID: $(laufende_pid)"
        return 0
    fi
    rm -f "$piddatei"
    echo "FEHLER: Midea2Lox wurde gestartet, lief aber nach zwei Sekunden"
    echo "        nicht mehr. Der Grund steht in $logdir/midea2lox.log -"
    echo "        meist eine unvollstaendige Konfiguration."
    return 1
}

stop_dienst() {
    local p i
    # Zuerst die Merkmarke fort - sonst startet der Waechter den Dienst in
    # der naechsten Minute wieder, waehrend hier noch beendet wird.
    rm -f "$sollmarke"
    if ! p=$(laufende_pid); then
        echo "Midea2Lox laeuft nicht."
        rm -f "$piddatei"
        return 0
    fi
    echo "Beende Midea2Lox (PID $p)..."
    kill "$p" 2>/dev/null
    # Zeit zum Aufraeumen lassen: der Dienst meldet beim Beenden noch
    # 'disconnected' per MQTT, damit Loxone den Ausfall mitbekommt.
    i=0
    while [ $i -lt 20 ] && kill -0 "$p" 2>/dev/null; do
        sleep 0.25
        i=$((i + 1))
    done
    if kill -0 "$p" 2>/dev/null && gehoert_uns "$p"; then
        kill -9 "$p" 2>/dev/null
    fi
    rm -f "$piddatei"
}

case "$1" in
    'start'|'')
        start_dienst ;;
    'stop')
        stop_dienst ;;
    'restart')
        stop_dienst
        start_dienst ;;
    'waechter')
        # Vom Cron benutzt: startet nur, wenn der Dienst laufen soll.
        if [ -f "$sollmarke" ] && ! laufende_pid >/dev/null; then
            start_dienst
        fi ;;
    'status')
        if p=$(laufende_pid); then
            echo "Midea2Lox laeuft. PID: $p"
        else
            echo "Midea2Lox ist gestoppt."
            exit 1
        fi ;;
    *)
        echo "Aufruf: $0 start|stop|restart|status"
        exit 1 ;;
esac
exit 0
